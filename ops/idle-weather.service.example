[Unit]
Description=Idle Weather eInk display service
After=network-online.target
Wants=network-online.target

[Service]
# The loop sends READY=1 on start and WATCHDOG=1 every minute. The longest gap
# between pings is one render (45 s) plus one panel push (60 s) plus the
# 60 s sleep, so 240 s leaves margin.
Type=notify
WatchdogSec=240s

User=pi
WorkingDirectory=/var/lib/idle-weather
StateDirectory=idle-weather
Environment=LG_WD=/var/lib/idle-weather

# Settings live in the config file (copy config.toml.example there).
ExecStart=/home/pi/.virtualenvs/idle-weather/bin/python -m idle_weather.run \
  --config %S/idle-weather/config.toml --pidfile %S/idle-weather/run.pid

# Stop the loop but let an in-flight panel push finish.
KillMode=mixed
TimeoutStopSec=90s

Restart=always
RestartSec=10
# Exit 42 is a configuration error: halt instead of flapping.
RestartPreventExitStatus=42

StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/idle-weather
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
